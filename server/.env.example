PORT=4000
MONGODB_URI=mongodb://localhost:27017/noway
JWT_SECRET=noway_access_secret_key_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=noway_refresh_secret_key_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Google Identity Services Client ID (from Google Cloud Console -> APIs & Credentials -> OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="NoWay Security" <no-reply@noway.com>

# Secret for signing cookies
COOKIE_SECRET=noway_secure_cookie_signing_secret_2026
